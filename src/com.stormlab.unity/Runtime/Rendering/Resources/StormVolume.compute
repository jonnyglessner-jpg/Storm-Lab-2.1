// The storm volume. BUILD paints the designed storm into a 3-D volume (the web build's BUILD pass, f5bd687, line for
// line), LIGHT computes sun and sky light on a third-resolution grid (the web build's LIGHT, storing the sun's optical
// depth rather than its transmittance, as StormLab 2.0 does), SKYVIS how much of the sky each point sees and
// GROUNDLIGHT how lit the ground under the storm is (2.0's physical sky and ground light).
// Volume texel: r = cloud, g = precipitation, b = near-ground features (shadows only), a = material
// (water 0.3 + 0.7 * turbulence, ice 0.3 * (1 - ice)).
#pragma kernel Build
#pragma kernel Light
#pragma kernel SkyVis
#pragma kernel GroundLight

#include "Packages/com.stormlab.unity/Runtime/Rendering/Shaders/StormCommon.hlsl"

RWTexture3D<float4> _OutD;

// ---- game adaptation beside the port (StormTilt, user 2026-10-27): the tilted updraft's rain-free base and the clear
// air round a tornado. x: the base's radius, y: the tornado's clear radius, km; zero for the web build's layout.
// z: 1 leaves out all rain (StormRenderer.hideRain, for checks). w: the cloud's extinction (CloudMax) for RainUnderCloud,
// 0 for the web build's layout.
float4 _PrecipP;
// RainUnderCloud's share of the rain kept, per column (written at the end of a repaint). x of _RainKeepP: 1 = Build applies
// it as it writes (a repaint spread over frames: the volume is drawn while it is repainted); y: 1 = RainUnderCloud also
// applies its new map to the volume in place (a repaint all at once, built with x = 0)
Texture2D<float> _RainKeep;
RWTexture2D<float> _OutKeep;
float4 _RainKeepP;
// what is left of the rain at p: none under the updraft's base on its inflow side (forward and right of the updraft,
// up into the vault) or round a tornado on the ground; flat inside, a soft edge out (a super-Gaussian), so the exposed
// base and the curtains' inner faces stay smooth
float precipClear(float3 p)
{
    if (_PrecipP.z > 0.5) return 0.0;
    float keep = 1.0;
    float zb = S_base.x;
    if (_PrecipP.x > 0.0)
    {
        float Rb = _PrecipP.x * lerp(1.0, 0.75, ss(zb, zb + 3.0, p.z));
        float2 c = S_up.xy + (S_f.xy - S_f.zw) * 0.42 * _PrecipP.x;
        float q = length(p.xy - c) / Rb;
        keep *= 1.0 - exp(-q * q * q * q) * ss(zb + 4.0, zb + 2.5, p.z);
    }
    if (_PrecipP.y > 0.0)
    {
        float q = length(p.xy - S_tor.xy) / _PrecipP.y;
        keep *= 1.0 - exp(-q * q * q * q) * ss(zb + 1.5, zb + 0.5, p.z);
    }
    return keep;
}

float hash1(float x) { return frac(sin(x * 127.1 + 311.7) * 43758.5453); }

// Material, stored in the alpha channel: water cloud 0.3 + 0.7 * turbulence (0 smooth .. 1 cauliflower);
// ice cloud (the anvil) 0.3 * (1 - ice), so 0 is pure ice
float water(float turb) { return 0.3 + 0.7 * saturate(turb); }
float icy(float ice) { return 0.3 * (1.0 - saturate(ice)); }

// a cumulus congestus tower: centre c, radius R, base zb, top zt. Near-vertical sides, a rounded top
float congestus(float3 p, float2 c, float R, float zb, float zt, float seed)
{
    float r = length(p.xy - c);
    if (r > R * 2.2 || p.z > zt + R * 1.2 || p.z < zb - 0.3) return 0.0;
    // lumps scaled to the tower, so small and large towers have the same cauliflower character
    float3 ps = p / max(R, 0.4) + float3(seed * 3.7, seed * 1.9, seed * 5.3);
    float n = 0.62 * n3(ps * 0.3) + 0.38 * n3(ps * 0.7 + float3(0.3, 0.6, 0.1)) - 0.5;
    float hz = saturate((p.z - zb) / max(zt - zb, 0.3));
    // a tower that narrows upward into a lumpy, turreted head
    float edge = R * (0.95 - 0.35 * hz * hz) + n * R * 0.8;
    float top = zt - 1.1 * R * pow(min(r / max(R, 0.1), 1.4), 2.0) + n * R * 1.0;
    // a soft, ragged base, a little higher toward the tower's edge (air rising into it), not a flat cut
    float zbt = zb + 0.15 * clamp(r / max(R, 0.1), 0.0, 1.2) + n * 0.3;
    return ss(0.45, -0.45, r - edge) * ss(zbt - 0.15, zbt + 0.3, p.z) * ss(top + 0.25, top - 0.45, p.z);
}

[numthreads(4, 4, 4)]
void Build(uint3 gid : SV_DispatchThreadID)
{
    uint nv = (uint)S_grid.x; uint nz = (uint)S_grid.y;
    uint3 id = uint3(gid.x, gid.y, gid.z + (uint)S_slab.x);
    if (id.x >= nv || id.y >= nv || id.z >= nz) return;
    float L = S_grid.z; float ZT = S_grid.w;
    float3 p = float3(-L + (id.x + 0.5) * 2.0 * L / S_grid.x, -L + (id.y + 0.5) * 2.0 * L / S_grid.x, (id.z + 0.5) * ZT / S_grid.y);
    float2 fw = S_f.xy; float2 lf = S_f.zw; float zb = S_base.x; float el = S_base.y; float tmin = S_base.w;
    // nothing above the storm's top: skip the work
    if (p.z > el + 2.5) { _OutD[id] = float4(0.0, 0.0, 0.0, water(1.0)); return; }
    float cloud = 0.0; float rain = 0.0;
    // material blended by each feature's share of the cloud here, so it changes smoothly where features meet
    float mw = 1e-4; float ms = 1e-4 * water(1.0);
    float R = S_tower.y; float zt = S_tower.x;
    float zr = p.z - zb;

    // ---- main updraft. Low down, the rotating updraft (mesocyclone): a broad, upright barrel with a tucked rim
    // at cloud base (its striations are cut in the render pass, where they turn). Higher up, the convective tower,
    // widening like a bell into the anvil, with a domed top and an overshooting top above it.
    float2 c = mesoCentre(zr);
    float2 d = p.xy - c; float r = length(d);
    if (S_tower.z > 0.0 && r < R * 3.5 + 6.0)
    {
        float H = max(zt - zb, 0.5);
        float hz = saturate(zr / H);
        float lam = saturate(1.7 * S_tower.w) * (1.0 - ss(4.0, 7.5, zr));   // how laminar (striated) the updraft is here
        float young = 1.0 - saturate(S_anvil.w);
        // Keep the lower mesocyclone nearly vertical, with a modest flare and a rounded underside.
        // a young tower narrows into a turreted head; a mature one widens again toward the anvil
        float flare = baseFlare(zr);
        // The rising column broadens continuously as its vertical motion turns into
        // spreading outflow beneath the tropopause. Carry its cloud into the anvil root.
        float upperMerge = ss(el - 5.0, el - 0.8, p.z) * saturate(S_anvil.w);
        float trumpet = 1.85 * upperMerge * upperMerge;
        float rad0 = R * lerp(1.0, 0.8, young) * (1.0 + flare - 0.22 * S_tower.w * ss(0.05, 0.35, hz) + lerp(0.25 * ss(0.4, 0.8, hz) + trumpet, -0.3 * hz * hz, young));
        float rad = rad0 + mesoExtra(zr) + mesoShoulder(d, zr);
        float n = fbm(p) - 0.5;
        float lump = lerp(0.5, 1.7, ss(1.0, 5.0, zr)) * (1.0 - 0.75 * lam);
        float edge = rad + n * 2.2 * lump;
        // domed top: rounder while the tower is young, flatter once it spreads into the anvil
        float dome = lerp(lerp(0.9 * rad, 2.2, saturate(S_anvil.w)), 0.45, upperMerge);
        float top = zt - dome * pow(min(r / max(rad, 0.1), 1.5), 2.0) + n * lerp(lerp(1.1, 2.4, young), 0.7, upperMerge);
        // where the side slopes gently (the skirt) the edge moves a long way per grid level: widen the ramp to match, or
        // the surface shows terraces at every level
        float ew = 0.55 + 0.05 * R * (0.9 * S_tower.w + 0.12) * exp(-max(zr, 0.0));
        // the underside: rising air condensing unevenly, so not a knife-edge plane. Ragged, soft, and sloping up away
        // from the updraft core toward the rim of the skirt
        float nb = n3(p * 0.45 + float3(0.3, 0.8, 0.5)) - 0.5;
        float zbase = zb + baseLift() + underbellyRise(p.xy - mesoCentre(0.0)) + nb * 0.3;
        // Round the junction of side and underside, avoiding the knife edge produced by
        // intersecting a wide skirt with a separate flat base.
        float2 corner = float2(r - edge + 0.5, zbase - p.z + 0.5);
        float rounded = length(max(corner, 0.0)) + min(max(corner.x, corner.y), 0.0) - 0.5;
        float tw = ss(ew, -ew, rounded) * ss(top + 0.3, top - 0.6, p.z);
        // overshooting top: a dome pushing up through the anvil, rising as the updraft matures
        float oh = 1.8 * S_tilt.z;
        float od = length(float3(d / max(R * 0.75, 0.5), (p.z - el) / max(oh, 0.2)));
        tw = max(tw, ss(1.0, 0.65, od + n * 0.3) * ss(el - 1.5, el - 0.4, p.z) * step(0.01, S_tilt.z));
        float tv = S_tower.z * tw;
        // a young tower is a cluster of turrets, each a towering cumulus of its own, merging into one
        if (young > 0.02)
        {
            for (uint j = 0; j < 3; j++)
            {
                float fj = (float)j;
                float a = 2.1 * fj + 0.7; float2 o = float2(cos(a), sin(a)) * R * (0.62 + 0.1 * fj);
                float hj = (zt - zb) * (1.02 - 0.2 * fj);
                tv = max(tv, S_tower.z * young * congestus(p, c + o * (1.0 + 0.08 * max(zr, 0.0)), R * (0.48 - 0.05 * fj), zb, zb + hj, 11.0 + fj * 3.0));
            }
        }
        mw += tv * tv; ms += tv * tv * water(lerp(1.0, 0.12, lam));
        cloud = max(cloud, tv);
    }

    // Forward flank: precipitation only for now; no separate low/mid-level cloud body.

    // ---- inflow: warm, moist air streaming in from the east-south-east is drawn up into the updraft. Near the storm
    // the inflow tail thickens and climbs, rising as a smooth, banded ramp into the side of the mesocyclone: the
    // updraft's vaulted inflow side, kept apart from the rain on the forward flank
    if (S_tail.w > 0.0)
    {
        float2 t0 = tailRoot();   // (game adaptation: the game's line along the forward flank's edge, StormCommon.hlsl tailDir)
        float2 td = tailDir(); float2 tn = float2(-td.y, td.x);
        float sT = dot(p.xy - t0, td) + R * 0.6;                       // 0 at the updraft's edge, increasing outward
        float qT = dot(p.xy - t0, tn) - 0.035 * (S_tail.z - sT) * (S_tail.z - sT) * 0.12;
        if (sT > -3.0 && sT < S_tail.z && abs(qT) < 6.0 && p.z < zb + 5.0)
        {
            // A long eased ramp rolls into the updraft with a level tangent at its root,
            // avoiding the steep shoulder from the former short exponential rise.
            float rise = 1.0 - ss(-2.0, S_tail.z * (10.0 / 11.0), sT);
            float nI = fbm(p * 1.3 + float3(1.7, 0.4, 2.2)) - 0.5;
            float topI = zb + 0.9 + 3.4 * rise + nI * 0.4;
            float botI = zb - 0.04 + 0.25 * (1.0 - rise) + nI * 0.15;
            float wI = (1.0 + 2.2 * rise) * (0.8 + 0.4 * nI);
            // laminar bands along the inflow
            float band = 0.85 + 0.15 * sin(6.2832 * (p.z - zb) / 0.45 + sT * 0.4);
            // (game adaptation, _WallP.w; user, 2026-10-28: the beaver tail "too big and too long", and should "blend into
            // the main updraft more smoothly" and flow in: this ramp ran 10 km out and was the band seen, but the volume is
            // repainted only every few seconds, so it could not flow. In the game it keeps its first few kilometres, where
            // it rises into the updraft's side, and the render pass's beaver tail (StormCommon.hlsl beaverTail, streaming
            // in each frame) is the band beyond it, its widened root overlapping this ramp's end)
            // (an HP storm's reaches further, as its bigger beaver tail does: tailHP)
            float reachI = _WallP.w > 0.5 ? 1.0 - ss(lerp(2.5, 4.0, tailHP()), lerp(5.5, 9.0, tailHP()), sT + (nI - 0.5) * 1.5) : 1.0 - ss(S_tail.z * (8.0 / 11.0), S_tail.z, sT);
            float iv = tailAmt() * 0.9 * ss(wI + 0.4, wI - 0.6, abs(qT)) * ss(botI - 0.1, botI + 0.2, p.z) * ss(topI + 0.3, topI - 0.5, p.z)
                * ss(-3.0, -1.0, sT) * reachI * band;
            mw += iv * iv; ms += iv * iv * water(0.15);
            cloud = max(cloud, iv);
        }
    }

    // ---- anvil: ice spreading out under the tropopause. Seen from above (satellite), an oval canopy drawn out along
    // the wind aloft: its upwind end a sharp, rounded edge just upwind of the updraft (pushed there by the backshear),
    // bubbly with overshooting tops near the updraft, its widest part well downwind, tapering again far downstream.
    // Its top is flat and smooth with faint ripples; in cross-section it is a lens, thinning to feathered edges; thick
    // near the storm, it thins downstream into streaky cirrus that fades out rather than ending at a wall.
    // (The web build's mammatus are switched off: at this grid they read as holes.)
    if (S_anvil.w > 0.0 && p.z > el - 9.0)
    {
        float2 a0 = S_up.xy + S_tilt.xy * (el - zb);
        float2 ad = S_anvil.xy; float2 an = float2(-ad.y, ad.x);
        float s = dot(p.xy - a0, ad); float q = dot(p.xy - a0, an);
        float grow = S_anvil.w; float Lz = max(S_anvil.z, 2.0);
        float fr = saturate(s / Lz);
        // plan: an ellipse from just upwind of the updraft to the far end, about 2.5 times as long as it is wide
        // late (S_up.w): the canopy fills out in every direction, so it is rounder as well as longer
        float thin = S_up.w;
        float back = S_anvil2.w * grow;
        float nb = max(back + R * 0.5, 0.5);
        float A = 0.5 * (Lz + nb); float sc = 0.5 * (Lz - nb);
        float B = R * (1.2 + 0.6 * grow) + A * (0.34 + 0.16 * thin) * grow;
        // a slightly egg-shaped oval: fuller toward the storm's end
        float su = (s - sc) / A;
        float Bq = B * (1.0 - 0.18 * su);
        float e = length(float2(su, q / max(Bq, 0.5)));
        // the updraft spreads out in all directions under the tropopause: a round canopy round it, merged with the oval
        float outD = min((e - 1.0) * min(Bq, A), length(p.xy - a0) - R * 2.6 * (0.6 + 0.4 * grow) * (1.0 + 3.0 * thin));
        if (outD < 3.5)   // outside this the outline can't reach even with its noise
        {
            float n = fbm(p * 0.5 + float3(3.1, 1.7, 0.0)) - 0.5;
            float streak = 0.6 * n3(float3(s * 0.022, q * 0.2, p.z * 0.25) + float3(0.2, 0.5, 0.8)) + 0.4 * n3(float3(s * 0.05, q * 0.45, p.z * 0.4) + float3(0.7, 0.1, 0.5)) - 0.5;
            float inPlan = ss(1.4, -2.0, outD + n * 1.0 + streak * (0.5 + 1.0 * fr));
            // cross-section: a lens, thinning to feathered edges (but a sharp, steep edge upwind)
            float qe = saturate(e);
            float lens = lerp(sqrt(max(1.0 - qe * qe, 0.0)), pow(max(1.0 - qe * qe, 0.0), 0.2), ss(-0.3, -0.8, su));
            // vertical: flat top, a little higher over the updraft; thick near the storm, thin far out
            // over the updraft and its upwind side the top bulges up into a dome of turrets; downstream it is flat
            float headD = length(float2(max(-s, 0.0) / max(nb, 0.5), q / max(B, 0.5)));
            float bulge = (0.45 + 0.3 * n) * exp(-max(s, 0.0) / max(R * 2.0, 1.0)) * (1.0 - ss(0.6, 1.0, headD)) * grow;
            float topz = S_anvil2.y + 0.35 * exp(-max(s, 0.0) / 8.0) - 0.3 * fr + n * 0.06 + bulge;
            // the backsheared part stays thick, with a sharp edge, its underside sloping down toward the updraft
            float upw = ss(0.0, -nb, s);
            // after the first tornado cycle the far anvil thins to a veil of ice (S_up.w), so it keeps its reach without a heavy slab
            float thick = lerp(2.7, 0.3, pow(fr, lerp(0.55, 0.4, thin))) * lerp(1.0, 0.45, upw) * (0.55 + 0.45 * grow) * (0.2 + 0.8 * lens)
                * lerp(1.0, 0.6, thin * ss(0.08, 0.5, fr));
            // round the updraft the underside curves down into the tower, so tower and anvil are one smooth surface
            float dA = length(p.xy - a0);
            // A broad curved root, rather than a thin plate over a domed tower: its underside
            // rises continuously from the column to the spreading anvil canopy.
            float skirtA = 3.4 * (1.0 - ss(R * 0.9, R * 2.7, dA)) * grow;
            float botz = topz - thick - skirtA + n * 0.5 * thick + streak * 0.2 * fr;
            // a soft top over several grid levels, so the gently sloping top doesn't show a contour line where it crosses one
            float vert = ss(botz - 0.2, botz + 0.35, p.z) * ss(topz + 0.25, topz - 0.55, p.z + streak * 0.25);
            // downstream it thins into cirrus and fades out
            float dens = lerp(1.0, lerp(0.3, 0.2, thin), ss(0.05, 0.9, fr)) * (1.0 - ss(lerp(0.7, 0.85, thin), 1.05, fr + streak * 0.2)) * lerp(0.6, 1.0, lens);
            float av = inPlan * vert * dens;
            // the head of the storm, the upwind end and the first stretch downwind, is cauliflower like the tower beneath
            // it; the texture smooths out into streaky ice further downstream
            float rootWater = (1.0 - ss(R * 1.5, R * 2.8, dA)) * (1.0 - ss(R * 1.5, R * 3.5, max(s, 0.0)));
            float knuckle = max(rootWater, (1.0 - ss(R * 1.0, R * 1.0 + 0.18 * Lz, s)) * (1.0 - ss(0.35, 0.85, qe)));
            mw += av * av; ms += av * av * lerp(icy(0.35 + 0.65 * ss(0.02, 0.3, fr)), water(0.9), knuckle);
            cloud = max(cloud, av);
        }
    }

    // ---- flanking line: an irregular line of towering cumulus along the rear-flank gust front, curving away to the
    // rear and right, tops stepping down from the main updraft. Nearer towers are older and taller and lean into the
    // updraft; each rises and sags slowly as new towers grow and merge.
    if (S_flank.z > 0.0)
    {
        float2 fd = S_flank.xy; float2 rn = float2(fd.y, -fd.x);
        // in the second cycle the line matures into taller, thicker, more widely spaced towers
        float fm = S_wall2.w;
        float reach = 0.0;
        for (uint k = 0; k < 8; k++)
        {
            if ((float)k >= S_flank.w) break;
            float fk = (float)k;
            float h1 = hash1(fk * 7.31 + 1.3); float h2 = hash1(fk * 3.97 + 0.4); float h3 = hash1(fk * 5.13 + 2.2);
            float dist = R * 0.8 + 1.6 + fk * (2.7 + 0.9 * fm) + (h1 - 0.5) * 1.4;
            float2 ctr = S_up.xy + fd * dist + rn * (0.03 * dist * dist + (h2 - 0.5) * 1.3);
            float grow = saturate(S_flank.z * 1.7 - fk * 0.1);
            float life = 0.86 + 0.14 * sin(tmin * 0.3 + fk * 1.9);
            float Hk = 1.08 * (zt - zb) * (0.5 - 0.06 * fk) * (0.55 + 0.8 * h3) * grow * life * (1.0 + 0.5 * fm);
            if (Hk < 0.25) continue;
            reach = max(reach, dist);
            float rk = 1.12 * (2.3 - 0.17 * fk) * (0.75 + 0.45 * h1) * (0.65 + 0.35 * grow) * (1.0 + 0.6 * fm);
            float2 lean = -fd * 0.16 * max(zr, 0.0);
            float fv = congestus(p, ctr + lean, rk, zb, zb + Hk, fk + 0.37);
            // a second, smaller turret on the same base
            float2 off = float2(h2 - 0.5, h3 - 0.5) * rk * 1.5;
            fv = max(fv, congestus(p, ctr + off + lean * 0.8, rk * 0.65, zb, zb + Hk * (0.5 + 0.45 * h1), fk + 4.1));
            float2 off2 = float2(h1 - 0.5, 0.5 - h2) * rk * 1.6;
            fv = max(fv, congestus(p, ctr + off2 + lean * 0.9, rk * 0.5, zb, zb + Hk * (0.35 + 0.5 * h2), fk + 8.3));
            mw += fv * fv; ms += fv * fv * water(1.0);
            cloud = max(cloud, fv);
        }
        // the line's shared base, a low ragged shelf joining the towers to the updraft
        float2 rel = p.xy - S_up.xy; float al = dot(rel, fd);
        float offs = dot(rel, rn) - 0.03 * al * al;
        if (reach > 0.0 && abs(offs) < 2.5 * (1.0 + 0.6 * fm) && al > 0.0 && al < reach + 1.0 && p.z < zb + 1.6)
        {
            float nb = n3(p * 0.7 + float3(0.9, 0.3, 0.1)) - 0.5;
            float sh = ss(1.22 * (1.0 + 0.6 * fm), 0.55, abs(offs) + nb * 0.8) * ss(R * 0.5, R + 0.5, al) * ss(reach - 0.5, reach - 2.5, al)
                * ss(zb - 0.1 + nb * 0.3, zb + 0.3 + nb * 0.3, p.z) * ss(zb + 0.8 + nb * 0.4, zb + 0.35, p.z) * 0.7;
            mw += sh * sh; ms += sh * sh * water(0.6);
            cloud = max(cloud, sh);
        }
    }

    // A continuous apron rises from the horseshoe into the rotating barrel. Its radial
    // thickness and centre converge on the updraft with height instead of making separate towers.
    if (S_rfdb.w > 0.0 && zr > -0.2 && zr < 3.5)
    {
        float join = ss(0.0, 3.0, zr);
        float2 ac = lerp(S_rfdb.xy, mesoCentre(zr), join);
        float ar = lerp(S_rfdb.z + 0.45, R + mesoExtra(zr), join);
        float2 db = p.xy - S_rfdb.xy;
        float th = atan2(dot(db, lf), dot(db, fw));
        float arc = lerp(horseshoeArc(th), 1.0, join);
        float inner = lerp(ss(S_rfdb.z * 0.55, S_rfdb.z * 0.85, length(db)), 1.0, join);
        float n = fbm(p) - 0.5;
        float apronBase = zb + baseLift() + underbellyRise(p.xy - mesoCentre(0.0));
        float apron = S_rfdb.w * arc * inner * ss(ar + 0.5, ar - 0.5, length(p.xy - ac) + n * 0.35)
            * ss(apronBase - 0.15, apronBase + 0.35, p.z) * ss(3.5, 2.5, zr);
        mw += apron * apron; ms += apron * apron * water(0.12);
        cloud = max(cloud, apron);
    }

    // ---- wall cloud, tail cloud and inflow tail: drawn in the render pass; the volume keeps a coarse copy
    // (blue channel) only for their shadows
    float nearV = nearField(p, 0.0);

    // ---- precipitation: streaky curtains under the forward flank, a hail core next to the updraft. Shafts come out
    // from beneath the anvil and reach the ground as they grow.
    float below = ss(zb + 1.2, zb - 0.3, p.z);
    // Carry the shaft into the anvil cloud so its upper fade is hidden within the source,
    // rather than stopping below the canopy. Rear-flank rain retains its low-level mask.
    float precipTop = lerp(zb + 0.7, el - 0.8, saturate(S_anvil.w));
    float curt = 0.0;
    if (p.z < precipTop + 0.5)
    {
        curt = (0.35 + 0.65 * ss(0.3, 0.7, n3(float3(p.x * 0.11 + p.z * 0.01, p.y * 0.11, p.z * 0.02))))
            * (0.55 + 0.6 * n3(float3(p.x * 0.45, p.y * 0.45, p.z * 0.04) + float3(0.3, 0.5, 0.1)));
    }
    float forwardBelow = ss(precipTop + 0.5, precipTop - 0.8, p.z);
    if (S_ffd.w > 0.0 && forwardBelow > 0.0)
    {
        float reachF = zb * (1.0 - saturate(S_ffd.w * 1.6));
        float2 fq = p.xy - S_ffd.xy;
        float2 rainQ = float2(dot(fq, fw) / (6.0 * S_ffd.z), dot(fq, lf) / (4.0 * S_ffd.z));
        // Extend the existing rain core mostly eastward, with a smaller northern reach.
        // Sweep its elliptical profile rather than shifting it, preserving the original core
        // and a smoothly rounded outer edge. Pulse storms retain their centred rain shaft.
        float2 extension = float2(7.5, 2.5) * S_ffd.z * saturate(S_ffd.w) * ss(0.0, 0.02, S_tilt.w);
        float2 sweep = float2(dot(extension, fw) / (6.0 * S_ffd.z), dot(extension, lf) / (4.0 * S_ffd.z));
        float along = saturate(dot(rainQ, sweep) / max(dot(sweep, sweep), 0.0001));
        float2 rainEdge = rainQ - sweep * along;
        // Once the storm is in its late phase (S_up.w, after the first tornado cycle) the straight-down forward-flank rain
        // is lighter, and lighter still close to the tornado: most of that rain is carried round with the RFD instead.
        float lateFfd = (1.0 - 0.45 * S_up.w) * lerp(1.0, ss(2.5, 7.5, length(p.xy - S_wall.xy)), S_up.w);
        float foot = exp(-dot(rainEdge, rainEdge));
        // ---- game adaptation (user, 2026-10-28, with the cloud deck below: "straight edged"; the Tilted layout): the
        // curtain's edge was the same at every height, so seen side-on it was a ruler-straight vertical line from the cloud
        // to the ground, and crisp once the unified lighting's rain was denser. Its footprint now leans downwind with height
        // (rain falls through the wind; about 15 degrees) and its edge frays with noise that changes every kilometre or so
        // up, breaking it into shafts that end at different places.
        if (_PrecipP.w > 0.0)
        {
            float2 fqL = fq - fw * 0.25 * max(p.z - zb, 0.0);
            float2 rqL = float2(dot(fqL, fw) / (6.0 * S_ffd.z), dot(fqL, lf) / (4.0 * S_ffd.z));
            float2 reL = rqL - sweep * saturate(dot(rqL, sweep) / max(dot(sweep, sweep), 0.0001));
            float nR = n3(float3(p.x * 0.35, p.y * 0.35, p.z * 0.7) + float3(0.8, 0.2, 0.6)) - 0.5;
            foot = exp(-dot(reL, reL));
            foot *= ss(0.02, 0.4, foot + nR * 0.45);
        }
        float rainF = S_ffd.w * lateFfd * foot * curt * forwardBelow * ss(reachF - 0.2, reachF + 0.3, p.z);
        rain = max(rain, rainF);
        // ---- game adaptation (user, 2026-10-28: "add the cloud deck"; the Tilted layout, _PrecipP.w): the forward-flank
        // rain's own cloud. The web build has none (above), so its rain fell out of the anvil's underside alone and a sun
        // under 40 degrees lit it from the side. A deep mass of cloud over the rain's footprint (its core and its sweep
        // downwind), under the anvil and rising into it near the core. It comes with the anvil (a young storm's rain falls
        // from its tower) and thins as the forward-flank rain does late in the storm.
        // Its shape (user, same day: "unnatural, and straight edged. Blend it into the rain"): the first deck was a box, a
        // flat base and top and steep sides over a smooth ellipse, floating under the anvil. Now its outline wanders (noise
        // at about 5 km), it thins toward the outline as a lens does (the base rises and the top falls), its base is ragged
        // and higher downwind (rain-cooled air condenses higher), and where the rain under it is heavy it trails ragged tags
        // down into the rain over a kilometre and a half.
        if (_PrecipP.w > 0.0 && S_anvil.w > 0.0)
        {
            float nD = fbm(p * 0.6 + float3(2.3, 0.7, 1.9)) - 0.5;
            float nE = fbm(p * 0.18 + float3(0.9, 3.1, 0.4)) - 0.5;
            float plan = ss(0.03, 0.7, exp(-dot(rainEdge, rainEdge)) + nD * 0.2 + nE * 0.35);
            float lens = sqrt(plan);
            float rag = n3(p * 1.3 + float3(0.4, 0.9, 0.2)) - 0.5;
            float nearCore = ss(0.3, 0.9, exp(-dot(rainQ, rainQ)));
            float zLo = zb + lerp(1.0, 2.2, along) + nD * 0.6 + rag * 0.4 + 2.2 * (1.0 - lens);
            float zHi = lerp(zb + lerp(5.0, 3.8, along), el - 2.5, nearCore) + nD * 1.6 + nE * 1.0 - 3.2 * (1.0 - lens);
            float body = plan * ss(zLo - 0.5, zLo + 1.0, p.z) * ss(zHi + 0.8, zHi - 1.2, p.z);
            float drape = plan * ss(0.05, 0.4, rainF) * ss(zLo - 1.5, zLo, p.z) * saturate(0.6 + 0.8 * rag) * 0.6;
            float deck = 0.85 * saturate(2.0 * S_anvil.w) * saturate(S_ffd.w) * lateFfd * max(body, drape);
            mw += deck * deck; ms += deck * deck * water(0.35);
            cloud = max(cloud, deck);
        }
    }
    if (S_hail.w > 0.0 && forwardBelow > 0.0)
    {
        float reachH = zb * (1.0 - saturate(S_hail.w * 1.6));
        float hq = length(p.xy - S_hail.xy) / S_hail.z; float hh = exp(-hq * hq) * curt * forwardBelow * ss(reachH - 0.2, reachH + 0.3, p.z);
        rain = max(rain, S_hail.w * hh * 0.9);
    }

    // ---- rear-flank downdraft rain: curtains wrapping round the north and west of the surge (the hook), and round
    // all of it in an HP storm
    if (S_rfdb.z > 0.0 && below > 0.0)
    {
        float2 db = p.xy - S_rfdb.xy; float rb = length(db); float Rs = S_rfdb.z;
        float th = atan2(dot(db, lf), dot(db, fw));
        float nsl = n3(float3(p.x * 0.35, p.y * 0.35, p.z * 0.25) + float3(0.7, 0.7, 0.1)) - 0.5;
        float hook = max(ss(-0.25, 0.55, cos(th - 1.9)), S_rfd.w);
        float ring = ss(Rs * 0.45, Rs * 0.8, rb + nsl * 0.8) * ss(Rs * 1.15, Rs * 0.92, rb + nsl * 0.6);
        // the curtain thins out as it curls round toward the tornado (at the wall cloud, the northern end of the surge)
        float toTor = length(p.xy - S_wall.xy);
        float torTaper = ss(0.3 * Rs, 2.4 * Rs, toTor);
        rain = max(rain, S_rfd.z * ring * hook * torTaper * curt * below * 0.6);
    }

    // Apply after every feature, so no cloud shelf plugs the rear opening. Rain is not cut: it falls through the slot.
    cloud *= 1.0 - clearSlot(p);
    // The forward-flank rain curls round the updraft and down into the clear slot: a curtain that follows a spiral
    // from the forward-flank core, anticlockwise round the left and rear of the updraft, closing in on the slot, and
    // thinning out as it nears the tornado at the wall cloud. Its upper end hugs the cloud base once it is past the
    // forward flank.
    float slotWrap = ss(0.05, 0.5, S_rfd.x);
    if (S_ffd.w > 0.0 && slotWrap > 0.0)
    {
        float2 dU = p.xy - S_up.xy;
        float phi = atan2(dot(dU, lf), dot(dU, fw));
        float psi = phi < -0.35 ? phi + 6.2832 : phi;   // 0.65 rad at the forward-flank core, about 3.8 rad at the wall cloud
        float sp = saturate((psi - 0.65) / 3.15);
        float r0 = lerp(max(length(S_ffd.xy - S_up.xy), 3.0), 0.9 * S_tower.y, sp * sp * (3.0 - 2.0 * sp));
        float wid = lerp(2.6, 1.5, sp);
        float drr = (length(dU) - r0) / wid;
        float towardTor = 1.0 - ss(2.8, 3.9, psi);
        float arc = ss(0.45, 0.8, psi) * towardTor * exp(-drr * drr);
        float reachW = zb * (1.0 - saturate(S_ffd.w * 1.6));
        float hgt = lerp(forwardBelow, below, sp);
        rain = max(rain, 0.9 * (1.0 + 0.3 * S_up.w) * S_ffd.w * slotWrap * arc * curt * hgt * ss(reachW - 0.2, reachW + 0.3, p.z));
    }
    rain *= precipClear(p);   // game adaptation (StormTilt), not the web build's
    if (_RainKeepP.x > 0.5) rain *= _RainKeep[id.xy];   // game adaptation (RainUnderCloud below)
    _OutD[id] = float4(sqrt(saturate(cloud)), sqrt(saturate(rain)), sqrt(saturate(nearV)), ms / mw);
}

// ---- game adaptation (user, 2026-10-28: "trim the rain shield"), run once the whole volume is built: the forward-flank
// rain's sweep downwind reaches the ground only out of cloud that reaches down to mid levels. The web build's forward-flank
// rain has no cloud of its own (above: "precipitation only for now"); its sweep (up to 7.5 km past the core) fell 9 km out
// of the anvil's underside with nothing below 6 km, and a sun under 40 degrees slipped under the anvil and lit it white
// from 20 km off (StormGameCheck -slGameProbe). Heavy rain falls from deep cloud; an anvil alone gives virga. Per column:
// the cloud's optical depth below the base + 6 km, averaged over 9 columns out to 5 km (so the rain's edge is soft and
// does not follow the cloud's noise), keeps the rain by smoothstep(0.5, 10) of it; the designed cores (the forward-flank
// core's own ellipse without its sweep, the hail core) keep theirs. Cutting the cores too left no forward-flank rain.
// The share kept goes to a per-column map (_OutKeep). A repaint spread over frames applies the last repaint's map as it
// writes each slab: trimming the volume in place only when the last slab was done left every slab repainted before it
// with the whole sweep for a few frames, a flash at every repaint (user, 2026-10-28; StormLightCheck -slLightFlicker:
// 11 % more rain for 3 frames). The map then lags the storm by one repaint, a fraction of a second.
#pragma kernel RainUnderCloud
[numthreads(8, 8, 1)]
void RainUnderCloud(uint3 id : SV_DispatchThreadID)
{
    uint nv = (uint)S_grid.x; uint nz = (uint)S_grid.y;
    if (id.x >= nv || id.y >= nv) return;
    if (_PrecipP.w <= 0.0) { _OutKeep[id.xy] = 1.0; return; }
    float L = S_grid.z;
    float2 p = float2(-L + (id.x + 0.5) * 2.0 * L / S_grid.x, -L + (id.y + 0.5) * 2.0 * L / S_grid.x);
    float core = 0.0;
    if (S_ffd.w > 0.0)
    {
        float2 fq = p - S_ffd.xy;
        float2 rq = float2(dot(fq, S_f.xy) / (6.0 * S_ffd.z), dot(fq, S_f.zw) / (4.0 * S_ffd.z));
        core = exp(-dot(rq, rq));
    }
    if (S_hail.w > 0.0) { float hq = length(p - S_hail.xy) / S_hail.z; core = max(core, exp(-hq * hq)); }
    float keepCore = ss(0.05, 0.4, core);
    if (keepCore >= 1.0) { _OutKeep[id.xy] = 1.0; return; }
    float dz = S_grid.w / S_grid.y;
    uint ztop = min(nz, (uint)ceil((S_base.x + 6.0) / dz));
    float km = S_grid.x / (2.0 * L);   // cells per km
    int a = max(1, (int)round(2.5 * km)), b = max(1, (int)round(3.5 * km));
    int2 taps[9] = { int2(0, 0), int2(a, 0), int2(-a, 0), int2(0, a), int2(0, -a), int2(b, b), int2(-b, b), int2(b, -b), int2(-b, -b) };
    float tau = 0.0;
    [unroll] for (int k = 0; k < 9; k++)
    {
        uint2 xy = (uint2)clamp(int2(id.xy) + taps[k], 0, (int)nv - 1);
        for (uint z = 0; z < ztop; z++) { float c = _OutD[uint3(xy, z)].r; tau += c * c; }   // (the volume holds sqrt(cloud))
    }
    float kept = max(keepCore, ss(0.5, 10.0, tau / 9.0 * dz * _PrecipP.w));
    _OutKeep[id.xy] = kept;
    float keep = sqrt(kept);
    if (keep >= 1.0 || _RainKeepP.y < 0.5) return;
    for (uint z2 = 0; z2 < nz; z2++) { float4 d = _OutD[uint3(id.xy, z2)]; d.g *= keep; _OutD[uint3(id.xy, z2)] = d; }
}

// ------------------------------------------------------------------------------------------------ light
// Lighting on a third-resolution grid, computed once per volume update (not per pixel per frame):
//   r  the key light's optical depth (sunT turns it into the web build's transmittance), with the web build's near
//      sunward blocker for water cloud folded in as extra depth
//   g  skylight (transmittance straight up)
//   b  how open the sky is just overhead: dark under bases and shelves (water cloud)
//   a  ice shade: anvil undersides in the shade of the ice above them, lit tops and rims (ice)
// and the web build's own sun channel in _OutLW: its transmittance with the blocker (an RGBA8 grid, filtered as
// transmittance), which its lighting reads, so it matches the web build where shadow edges are interpolated
RWTexture3D<float4> _OutL;
RWTexture3D<float> _OutLW;
Texture3D<float4> _Dens;
// sun.xyz; dims: grid N, NZ, L km, ZT km; p: cloud max, rain max, step km, cloud base km; slab: x first z
float4 _LSun, _LDims, _LP, _LSlab;

float3 luvw(float3 p) { return float3((p.x + _LDims.z) / (2.0 * _LDims.z), (p.y + _LDims.z) / (2.0 * _LDims.z), p.z / _LDims.w); }
float dr(float3 p) { return _Dens.SampleLevel(sampler_LinearClamp, luvw(p), 0).r; }
float betaL(float3 p) { float4 d = _Dens.SampleLevel(sampler_LinearClamp, luvw(p), 0); return (d.r * d.r + d.b * d.b) * _LP.x + d.g * d.g * _LP.y; }

[numthreads(4, 4, 4)]
void Light(uint3 gid : SV_DispatchThreadID)
{
    uint nv = (uint)_LDims.x; uint nz = (uint)_LDims.y;
    uint3 id = uint3(gid.x, gid.y, gid.z + (uint)_LSlab.x);
    if (id.x >= nv || id.y >= nv || id.z >= nz) return;
    float dx = 2.0 * _LDims.z / _LDims.x; float dz = _LDims.w / _LDims.y;
    float3 pos = float3(-_LDims.z + (id.x + 0.5) * dx, -_LDims.z + (id.y + 0.5) * dx, (id.z + 0.5) * dz);
    float4 here = _Dens.SampleLevel(sampler_LinearClamp, luvw(pos), 0);
    float ice = 1.0 - saturate(here.a / 0.3);
    float zb = _LP.w;
    // sun: march toward the sun in steps of st
    float st = _LP.z;
    // The steps lengthen with distance: a ray from the ground must climb the full height of the volume to see the anvil
    // (about 50 km at this sun elevation), or the anvil's shadow stops short with a hard edge.
    float tau = 0.0; float3 q = pos + _LSun.xyz * 0.5 * st;
    for (int i = 0; i < 64; i++)
    {
        if (q.z > _LDims.w || abs(q.x) > _LDims.z || abs(q.y) > _LDims.z) break;
        float ss2 = st * (1.0 + 0.06 * i);
        tau += betaL(q) * ss2; q += _LSun.xyz * ss2;
    }
    // water cloud: a blocker a little way sunward shades this cell (crevices between billows, the lee of a base's edge).
    // The web build dims the transmittance by up to half; as depth on the main lobe that is -ln(1 - x) / 0.38
    float blocker = ice < 0.2 ? 1.0 - 0.5 * saturate((dr(pos + _LSun.xyz * 0.9) - 0.3) * 2.0) : 1.0;
    _OutLW[id] = sunT(tau) * blocker;
    tau -= log(blocker) / 0.38;
    // sky: march straight up in steps of 2 dz
    float up = 0.0; float3 rr = pos + float3(0.0, 0.0, dz);
    for (int k2 = 0; k2 < 24; k2++) { if (rr.z > _LDims.w) break; up += betaL(rr) * 2.0 * dz; rr.z += 2.0 * dz; }
    // overhead: cloud just above this cell hides the sky (undersides of bases and shelves), not high in the storm
    float vUp = dr(pos + float3(0.0, 0.0, 0.5));
    float skyOcc = 1.0 - 0.75 * (1.0 - ss(zb + 2.0, zb + 4.0, pos.z)) * saturate((vUp - 0.3) * 2.2);
    // ice: the anvil's underside is in the shade of the ice above it; its top and rim stay bright. Probe up and toward
    // the sun, and compare ice above with ice below (sampled over a couple of km, so mammatus share the shade)
    float iceShade = 1.0;
    if (ice > 0.05)
    {
        float above = saturate((dr(pos + float3(0.0, 0.0, 0.6)) - 0.1) * 3.0) * 0.55 + saturate((dr(pos + float3(0.0, 0.0, 1.5)) - 0.1) * 3.0) * 0.45;
        float sunward = saturate((dr(pos + _LSun.xyz * 1.2) - 0.1) * 3.0) * 0.55 + saturate((dr(pos + _LSun.xyz * 3.0) - 0.1) * 3.0) * 0.45;
        float ua = 0.0; float dn = 0.0;
        for (int k = 0; k < 4; k++)
        {
            float3 o = float3(cos(k * 1.571), sin(k * 1.571), 0.0) * 1.2;
            ua += dr(pos + o + float3(0.0, 0.0, 1.0)); dn += dr(pos + o - float3(0.0, 0.0, 1.0));
        }
        float under = ss(0.0, 0.4, (ua - 1.5 * dn) * 0.25);
        iceShade = (1.0 - 0.8 * sunward) * (1.0 - 0.8 * under) * (1.0 - 0.3 * above);
    }
    _OutL[id] = float4(tau, exp(-0.1 * up), skyOcc, iceShade);
}

// ------------------------------------------------------------------------------------------------ sky visibility
// StormLab 2.0: how much of the sky a point sees, in four parts, for the march's sky light: r the cap within 35 degrees
// of the zenith, g the ring 35-70 degrees from it, b the horizon ring (the light that reaches under a cloud base from
// the side) and a the horizon weighted toward the sun's or moon's bearing (the bright side at sunset). 19 cone traces
// through the volume (zenith and 4 at 25 degrees; 6 at 50; 8 at 82, 8 degrees above the horizon), 8 steps each
// growing 1.6x from 0.25 km (17.5 km). Optical depth becomes visibility as exp(-0.1 tau), the web build's
// sky-from-above rate. The march (skyLight) uses the same directions; SkyLighting.Bands integrates the sky over them.
RWTexture3D<float4> _OutS;

float skyTrace(float3 p, float3 d)
{
    float tau = 0.0, a = 0.0, s = 0.25;
    [unroll] for (int k = 0; k < 8; k++)
    {
        float3 q = p + d * (a + 0.5 * s);
        if (q.z > _LDims.w || q.z < 0.0 || abs(q.x) > _LDims.z || abs(q.y) > _LDims.z) break;
        tau += betaL(q) * s; a += s; s *= 1.6;
    }
    return exp(-0.1 * tau);
}

[numthreads(4, 4, 4)]
void SkyVis(uint3 gid : SV_DispatchThreadID)
{
    uint nv = (uint)_LDims.x; uint nz = (uint)_LDims.y;
    uint3 id = uint3(gid.x, gid.y, gid.z + (uint)_LSlab.x);
    if (id.x >= nv || id.y >= nv || id.z >= nz) return;
    float dx = 2.0 * _LDims.z / _LDims.x; float dz = _LDims.w / _LDims.y;
    float3 pos = float3(-_LDims.z + (id.x + 0.5) * dx, -_LDims.z + (id.y + 0.5) * dx, (id.z + 0.5) * dz);
    float zen = skyTrace(pos, float3(0.0, 0.0, 1.0));
    [unroll] for (int i = 0; i < 4; i++) { float a = i * 1.5708 + 0.7854; zen += skyTrace(pos, float3(cos(a) * 0.4226, sin(a) * 0.4226, 0.9063)); }
    float mid = 0.0;
    [unroll] for (int j = 0; j < 6; j++) { float a = j * 1.0472; mid += skyTrace(pos, float3(cos(a) * 0.766, sin(a) * 0.766, 0.6428)); }
    float hor = 0.0, hk = 0.0, wk = 0.0;
    float2 kd = normalize(_LSun.xy + float2(1e-5, 0.0));
    [unroll] for (int k = 0; k < 8; k++)
    {
        float a = k * 0.7854; float2 h = float2(cos(a), sin(a));
        float v = skyTrace(pos, float3(h * 0.9903, 0.1392));
        float w = max(dot(h, kd), 0.0); w *= w;
        hor += v; hk += w * v; wk += w;
    }
    _OutS[id] = float4(zen * 0.2, mid / 6.0, hor / 8.0, hk / max(wk, 1e-4));
}

// ------------------------------------------------------------------------------------------------ ground light
// StormLab 2.0: how lit the ground is, averaged over the 4 km a cloud base above it sees (13 taps): r the sun's (or
// moon's) transmittance to the ground, g its sky from above. The march turns it into light bounced up onto undersides.
RWTexture2D<float2> _OutG;
Texture3D<float4> _LightIn;

[numthreads(8, 8, 1)]
void GroundLight(uint3 id : SV_DispatchThreadID)
{
    uint nv = (uint)_LDims.x;
    if (id.x >= nv || id.y >= nv) return;
    float dx = 2.0 * _LDims.z / _LDims.x;
    float2 p = float2(-_LDims.z + (id.x + 0.5) * dx, -_LDims.z + (id.y + 0.5) * dx);
    float2 acc = 0.0;
    [unroll] for (int k = 0; k < 13; k++)
    {
        float r = k == 0 ? 0.0 : (k <= 6 ? 2.0 : 4.0);
        float a = k * 1.0472 + (k > 6 ? 0.5236 : 0.0);
        float4 l = _LightIn.SampleLevel(sampler_LinearClamp, luvw(float3(p + r * float2(cos(a), sin(a)), 0.05)), 0);
        acc += float2(sunT(l.r), l.g);
    }
    _OutG[id.xy] = acc / 13.0;
}
